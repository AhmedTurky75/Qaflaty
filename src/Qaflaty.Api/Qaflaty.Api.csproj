<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>qaflaty-api-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.2" />
    <!-- Pinned above the version SignalR.StackExchangeRedis brings in transitively (2.5.187) to
         resolve NU1902/NU1903 security advisories (fixed as of 2.5.301). Staying on the 2.x line
         avoids MessagePack 3.x's breaking API changes, which this SignalR package wasn't built against. -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.0.0" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		<PrivateAssets>all</PrivateAssets>
	</PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qaflaty.Domain\Qaflaty.Domain.csproj" />
    <ProjectReference Include="..\Qaflaty.Application\Qaflaty.Application.csproj" />
    <ProjectReference Include="..\Qaflaty.Infrastructure\Qaflaty.Infrastructure.csproj" />
  </ItemGroup>

  <ProjectExtensions><VisualStudio><UserProperties properties_4launchsettings_1json__JsonSchema="" /></VisualStudio></ProjectExtensions>

</Project>
