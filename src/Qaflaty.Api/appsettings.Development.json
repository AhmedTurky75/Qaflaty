{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Information"
      }
    }
  },
  // Set via `dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."`
  // or the ConnectionStrings__DefaultConnection environment variable — never commit real credentials here.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "development-secret-key-minimum-32-characters-long-for-security",
    "Issuer": "Qaflaty",
    "Audience": "QaflatyApp",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "MockOtp": {
    "Enabled": true,
    "Code": "000000"
  }
}
