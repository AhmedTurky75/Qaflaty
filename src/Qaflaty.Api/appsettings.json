{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/qaflaty-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "AllowedHosts": "*",
  // Set via the ConnectionStrings__DefaultConnection / ConnectionStrings__Redis environment
  // variables in every environment — never commit real credentials here. Redis powers the
  // real-time merchant analytics presence tracker and the SignalR backplane; leave it empty to
  // fall back to an in-process (single-instance-only) presence tracker with no backplane.
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "FileStorage": {
    "ContentRootPath": ""
  },
  "JwtSettings": {
    "SecretKey": "your-secret-key-here-minimum-32-characters-long-for-security",
    "Issuer": "Qaflaty",
    "Audience": "QaflatyApp",
    "AccessTokenExpirationMinutes": 60,
    "MerchantAccessTokenExpirationMinutes": 15,
    "CustomerAccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "UseSsl": true,
    "SenderEmail": "AhmedTurky75@gmail.com",
    "SenderName": "Qaflaty",
    "AppPassword": "phth wljc vuei jpdx"
  },
  // How many days an idle guest (anonymous) cart stays "open" before it's hidden from the
  // merchant's active-carts view and purged by GuestCartCleanupService. Authenticated customer
  // carts are never affected by this setting.
  "GuestCart": {
    "TtlDays": 3
  },
  //"AiAssistant": {
  //  "Provider": "Ollama",
  //  "ChatModel": "llama3.2:1b",
  //  "EmbeddingModel": "nomic-embed-text",
  //  "TimeoutSeconds": 60
  //},
  "AiAssistant": {
    "Provider": "LmStudio",
    "ApiKey": "lm-studio",
    "ChatModel": "Qwen2.5-0.5B-Instruct",
    "EmbeddingModel": "nomic-embed-text-v1.5",
    "TimeoutSeconds": 60
  },
  // RAG vector backend. Provider: "PgVector" (persistent, requires the pgvector extension) or
  // "InMemory" (process-local fallback). EmbeddingDimensions must match the embedding model and the
  // vector(N) column created by the AddKnowledgeVectorStore migration.
  "VectorStore": {
    "Provider": "PgVector",
    "EmbeddingDimensions": 768
  }
}
